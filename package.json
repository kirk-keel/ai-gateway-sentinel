{
  "name": "ai-gateway-sentinel",
  "version": "1.0.0",
  "type": "module",
  "description": "Containerized enterprise AI gateway and security proxy with PII guardrails, prompt injection defense, and FinOps observability",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "mock-upstream": "tsx src/mock-upstream/mock-server.ts",
    "benchmark:security": "tsx scripts/run-redteam-benchmark.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "PYTHONPATH=sdk/python python3 -m unittest discover sdk/python/tests",
    "test:all": "vitest run && npm run test:python"
  },
  "keywords": [
    "ai-gateway",
    "llm-proxy",
    "guardrails",
    "prompt-injection",
    "pii-redaction",
    "finops",
    "prometheus",
    "grafana"
  ],
  "author": "Enterprise Architecture & AI Security",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
