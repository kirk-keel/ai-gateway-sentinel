# Sentinel Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Upstream LLM Provider (Point to mock upstream or OpenAI/Anthropic/vLLM)
# Default for Docker Compose is http://mock-upstream:8001/v1
# For direct OpenAI: https://api.openai.com/v1
UPSTREAM_LLM_URL=http://localhost:8001/v1
UPSTREAM_API_KEY=

# Default Model fallback
DEFAULT_MODEL=gpt-4o

# Multi-tenancy Header
TENANT_HEADER_NAME=x-tenant-id

# Redis Prompt Caching
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=3600

# Security Guardrails Configuration
GUARDRAILS_ENABLED=true
GUARDRAILS_BLOCK_ON_PII=false
GUARDRAILS_INJECTION_THRESHOLD=0.65

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
