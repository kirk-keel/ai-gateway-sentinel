# ========================================================
# AI Gateway Sentinel - Environment Configuration
# ========================================================

# --- Server Configuration ---
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Upstream LLM Provider ---
# Default for Docker Compose is http://mock-upstream:8001/v1
# For direct OpenAI: https://api.openai.com/v1
# For local vLLM / Ollama: http://localhost:8000/v1
UPSTREAM_LLM_URL=http://localhost:8001/v1
UPSTREAM_API_KEY=

# Default fallback model when none specified in request
DEFAULT_MODEL=gpt-4o

# Multi-tenancy Header Name
TENANT_HEADER_NAME=x-tenant-id

# --- Redis & Prompt Caching ---
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=3600

# --- Security Guardrails & Token Vault ---
GUARDRAILS_ENABLED=true
GUARDRAILS_MODE=anonymize
GUARDRAILS_BLOCK_ON_PII=false
GUARDRAILS_INJECTION_THRESHOLD=0.65
VAULT_TTL_SECONDS=1800
SENTINEL_VAULT_KMS_KEY=sentinel-default-kms-master-secret-key-32b!

# --- FinOps & Budget Quota Management ---
BUDGET_ENFORCEMENT_ENABLED=true
DEFAULT_DAILY_BUDGET_USD=50.0
DEFAULT_MONTHLY_BUDGET_USD=1000.0

# --- Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Alerts & Webhook Notifications ---
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# --- Mock Upstream LLM Server (Development / Testing) ---
MOCK_PORT=8001
